{
  "name": "ts-utils",
  "version": "0.1.0",
  "description": "A high-performance, portable TypeScript utility library",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "quality-guard": "bash scripts/quality_guard.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsup": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
